---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import HeroImage from '@/components/content/HeroImage.astro';
import { siteConfig } from '@/data/site';
import { getCanonicalUrl } from '@/utils/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const {
  title,
  metaTitle,
  metaDescription,
  publishDate,
  lastUpdated,
  author,
  authorRole,
  authorBio,
  category,
  featuredImage,
} = entry.data;

const canonicalUrl = getCanonicalUrl(`/blog/${entry.id}`);

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: metaTitle || title,
  description: metaDescription,
  datePublished: publishDate,
  dateModified: lastUpdated,
  ...(featuredImage && {
    image: {
      '@type': 'ImageObject',
      url: `${siteConfig.url}${featuredImage}-1200.webp`,
      width: 1200,
      height: 675,
    },
    thumbnailUrl: `${siteConfig.url}${featuredImage}-400.webp`,
  }),
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteConfig.url,
  },
});

const breadcrumbItems = [
  { label: 'Blog', href: '/blog/' },
  { label: title },
];

const defaultAuthorBio = `${author} has spent years researching LLC formation services and business compliance requirements to help entrepreneurs make informed decisions.`;
---

<ArticleLayout
  title={metaTitle || title}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  ogImage={featuredImage ? `${featuredImage.replace(/\/hero$/, '/og.jpg')}` : undefined}
  schema={articleSchema}
  lastUpdated={lastUpdated}
  author={author}
  authorBio={authorBio || defaultAuthorBio}
  breadcrumbs={breadcrumbItems}
  showDisclosure={true}
  showTOC={true}
>
  {featuredImage && (
    <div class="mb-8 max-w-3xl">
      <HeroImage basePath={featuredImage} alt={title} />
    </div>
  )}
  <div class="prose">
    <Content />
  </div>
</ArticleLayout>
